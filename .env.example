# SYMBA T4.6 — example environment variables for the production compose
# (docker-compose.prod.yml). Copy to .env in the deploy directory and
# adjust as needed.

# Public port to expose the app on the host. Default: 8088.
SYMBA_PUBLIC_PORT=8088

# CORS origins (comma-separated, no spaces). Normally leave empty: the page and the API are
# served from the same origin (the frontend is built to call the origin it was loaded from),
# so no CORS is involved behind a reverse proxy. Only set it if they are on different origins:
#   BACKEND_CORS_ORIGINS=https://other-origin.example.org
BACKEND_CORS_ORIGINS=

# Secret that signs the sign-in tokens. REQUIRED for a public deployment (without it each
# restart signs everybody out). Generate one:  openssl rand -hex 32
SYMBA_JWT_SECRET=

# Public address of the tool (documentation only; the proxy config carries it):
#   https://biobasedisadvisor.symbaproject.eu

# (Optional) SQLite database URL override. Default points to
# /app/backend/data/app.db inside the container. Mount a volume there
# (compose does this by default) for persistence.
# SYMBA_DB_URL=sqlite:////app/backend/data/app.db
