    {
      "id": "flow_classification",
      "title_en": "Flow classification (waste / co-product / by-product)",
      "description_en": "One row per flow, whatever Q5 says: the legal and economic tests that decide how a flow is treated (D4.1 §8.3, D4.2 §6.2). They are the analyst's judgements: Q5 only records who pays whom, and nothing cross-checks the two, so keep this consistent with the Q5 class of the flow in the Flow Matrix.",
      "applies_when": "q3.env or q3.eco",
      "row_collection": "auto_from_flow_matrix",
      "filled_by": "analyst",
      "fields": [
        {
          "id": "classif.flow_id",
          "label_en": "Flow (FK)",
          "type": "fk_flow",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "classif.independent_market",
          "label_en": "Would a third party pay for it? (Freedom-to-Act)",
          "type": "enum",
          "enum_values": [
            "yes",
            "no",
            "unknown"
          ],
          "required": false,
          "activation_predicate": "always",
          "description_en": "D4.1 §8.3.3: if no independent buyer exists the price is administrative and the flow is a waste, even when Q5 says B pays A. Seeded from the flow's answer in the questionnaire (Sellable to others?) the first time the row is created; from then on this row is the analyst's."
        },
        {
          "id": "classif.avoidable",
          "label_en": "Causal avoidability",
          "type": "enum",
          "enum_values": [
            "unavoidable",
            "avoidable",
            "unknown"
          ],
          "required": false,
          "activation_predicate": "q3.eco",
          "description_en": "D4.2 §6.2: a zero-cost treatment needs the residue to be unavoidable and without positive market value; the causal avoidability test is declared per flow. In a company-level costing (C-LCC) the flow is booked at the negotiated price (D4.2 §6.3); the test still flags avoidable residues, for which a prevention scenario is reported."
        },
        {
          "id": "classif.legal_class",
          "label_en": "Legal classification",
          "type": "enum",
          "enum_values": [
            "product",
            "co_product",
            "by_product_art5",
            "waste_art3",
            "unknown"
          ],
          "required": false,
          "activation_predicate": "always",
          "description_en": "Product, co-product, by-product (Waste Framework Directive art. 5) or waste (art. 3)."
        },
        {
          "id": "classif.eow_status",
          "label_en": "End-of-Waste status",
          "type": "enum",
          "enum_values": [
            "achieved",
            "not_achieved",
            "pending",
            "not_applicable",
            "unknown"
          ],
          "required": false,
          "activation_predicate": "always",
          "description_en": "D4.1 §8.3.5: documents the status, it does not reclassify the flow."
        },
        {
          "id": "classif.zero_burden_point",
          "label_en": "Where the zero-burden assumption starts",
          "type": "enum",
          "enum_values": [
            "at_generation",
            "after_generator_pretreatment",
            "not_applicable"
          ],
          "required": false,
          "activation_predicate": "q3.env",
          "description_en": "D4.1 §8.3.6, Step 4: from the point where the residue first reaches non-negative value, not necessarily at the gate."
        },
        {
          "id": "classif.tree_step_reached",
          "label_en": "Decision-tree step reached",
          "type": "enum",
          "enum_values": [
            "step1_value",
            "step2_interdependence",
            "step3_dependent_coproduct",
            "step4_zero_burden"
          ],
          "required": false,
          "activation_predicate": "q3.env",
          "description_en": "D4.1 §8.3.6: the step of the decision tree at which the treatment of this flow was settled. In Situation C2 a co-product is allocated, not substituted (D4.1 §7.2.3); a waste keeps its zero-burden point (Step 4)."
        },
        {
          "id": "classif.edge_case",
          "label_en": "Edge case",
          "type": "enum",
          "enum_values": [
            "none",
            "negotiated_internal_price",
            "zero_priced_high_utility",
            "legally_waste_but_feedstock"
          ],
          "required": false,
          "activation_predicate": "always",
          "description_en": "Cases the tests do not settle on their own and that need an explicit, documented reading (cut-off or substitution)."
        },
        {
          "id": "classif.substituted_product",
          "label_en": "Product or process the flow replaces",
          "type": "string",
          "required": false,
          "activation_predicate": "(q3.env or q3.eco) and ilcd_situation != \"ILCD Situation C2\"",
          "description_en": "What the receiving actor would use without this flow, or what the origin would do with it: the substituted product of a substitution (D4.1 §8.3), and the counterpart of the price in the economic reference."
        },
        {
          "id": "classif.quality_factor_q",
          "label_en": "Quality factor Q (0-1)",
          "type": "float",
          "min": 0,
          "max": 1,
          "required": false,
          "activation_predicate": "q3.env and ilcd_situation != \"ILCD Situation C2\"",
          "description_en": "Ratio between the quality of the recovered flow and that of the product it replaces, which corrects the substitution credit (D4.1 §8.3)."
        },
        {
          "id": "classif.quality_factor_basis",
          "label_en": "Basis of the quality factor Q",
          "type": "text",
          "required": false,
          "activation_predicate": "q3.env and ilcd_situation != \"ILCD Situation C2\"",
          "description_en": "The property the ratio rests on (e.g. energy content, protein, purity) and its source."
        },
        {
          "id": "classif.substituted_lci_dataset",
          "label_en": "LCI dataset of the replaced product",
          "type": "string_docref",
          "required": false,
          "activation_predicate": "q3.env and ilcd_situation != \"ILCD Situation C2\"",
          "description_en": "Background dataset that models the substituted product, with database and version."
        },
        {
          "id": "classif.cff_a",
          "label_en": "CFF: A factor (0-1)",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "min": 0,
          "max": 1,
          "description_en": "Allocation of burdens and credits between the supplier and the user of the recycled material. The PEFCR value where one exists, otherwise the PEF method default (D4.1 §7.3.3)."
        },
        {
          "id": "classif.cff_b",
          "label_en": "CFF: B factor (0-1)",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "min": 0,
          "max": 1,
          "description_en": "Allocation of energy recovery between the current and the subsequent system; 0 in the PEF method unless a PEFCR says otherwise."
        },
        {
          "id": "classif.cff_r1",
          "label_en": "CFF: R1, recycled or recovered content (0-1)",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "min": 0,
          "max": 1,
          "description_en": "Share of the input to the receiving process that is this recovered flow."
        },
        {
          "id": "classif.cff_r2",
          "label_en": "CFF: R2, recycling rate at end of life (0-1)",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "min": 0,
          "max": 1
        },
        {
          "id": "classif.cff_r3",
          "label_en": "CFF: R3, energy recovery at end of life (0-1)",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "min": 0,
          "max": 1
        },
        {
          "id": "classif.cff_qsin_qp",
          "label_en": "CFF: Qsin/Qp, quality of the flow over the virgin material it replaces",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "min": 0,
          "description_en": "In Situation A and C1 with Q4 = D this is the quality factor Q of this row. In Situation B the CFF is a sensitivity next to the consequential model (T4.6 choice), so it may differ from the Q of the substitution."
        },
        {
          "id": "classif.cff_qsout_qp",
          "label_en": "CFF: Qsout/Qp, quality of the material recycled at end of life",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "min": 0
        },
        {
          "id": "classif.cff_source",
          "label_en": "Source of the CFF parameters",
          "type": "enum",
          "enum_values": [
            "pefcr",
            "pef_annex_c_default",
            "study_specific"
          ],
          "required": false,
          "activation_predicate": "q3.env and \"D\" in q4 and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "description_en": "Where an applicable PEFCR exists, its prescribed A and R values; otherwise the defaults published with the PEF method (D4.1 §7.3.3). The E-LCC applies the same A, Qs/Qp and R1/R2/R3 to the corresponding costs (D4.2 §5.1)."
        },
        {
          "id": "classif.evidence",
          "label_en": "Evidence and reasoning",
          "type": "text",
          "required": false,
          "activation_predicate": "always",
          "description_en": "Documents or reasoning behind the answers above."
        }
      ]
    },
    {
      "id": "reference_scenario",
      "title_en": "Reference scenario per actor and flow",
      "description_en": "One row per actor and per flow it gives or receives: for the origin, where the flow would go without the exchange (disposal route, other buyer); for the destination, what it would buy or produce instead (D4.1 §11.1).",
      "applies_when": "q3.env or q3.eco",
      "row_collection": "auto_from_flow_matrix",
      "filled_by": "both",
      "fields": [
        {
          "id": "ref.actor_id",
          "label_en": "Actor",
          "type": "fk_actor",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "ref.flow_id",
          "label_en": "Flow",
          "type": "fk_flow",
          "required": false,
          "activation_predicate": "always"
        },
        {
          "id": "ref.side",
          "label_en": "Side of the flow",
          "type": "enum",
          "enum_values": [
            "origin",
            "destination"
          ],
          "required": false,
          "activation_predicate": "always"
        },
        {
          "id": "ref.without_symbiosis",
          "label_en": "What this actor does, or would do, without this flow",
          "type": "text",
          "required": true,
          "activation_predicate": "always",
          "description_en": "For an origin: where the flow would go (disposal route, another buyer). For a receiver: what it would buy or produce in its place."
        },
        {
          "id": "ref.source",
          "label_en": "Source",
          "type": "string_docref",
          "required": false,
          "activation_predicate": "always",
          "description_en": "Where the information comes from (plant records, contract, interview, literature)."
        }
      ]
    },
    {
      "id": "logistics",
      "title_en": "Logistics",
      "description_en": "One row per route, i.e. per flow, co-located flows included: a pipeline, a conveyor or on-site handling is a unit process too (D4.1 §12.3.1). Auto-derived from the Flow Matrix. The break-even distance is asked for every flow, whatever Q7 says; a study with only the social dimension has no transport to model, so the section is off for it.",
      "applies_when": "q3.env or q3.eco",
      "row_collection": "auto_from_flow_matrix",
      "filled_by": "company",
      "fields": [
        {
          "id": "route.flow_id",
          "label_en": "Flow (FK)",
          "type": "fk_flow",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "route.organised_by",
          "label_en": "Transport organised by",
          "type": "enum",
          "enum_values": [
            "origin",
            "destination",
            "third_party"
          ],
          "required": false,
          "activation_predicate": "always",
          "description_en": "Who arranges and pays for the transport of this flow: the actor that gives it, the actor that receives it, or a third party (a joint logistics service, a facilitator). One value, agreed by the two partners. Every transport cost is traced to one partner (D4.2 §4.3)."
        },
        {
          "id": "route.distance_km",
          "label_en": "Distance (km)",
          "type": "float",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "route.transport_mode",
          "label_en": "Transport mode",
          "type": "enum",
          "enum_values": [
            "truck",
            "rail",
            "ship",
            "pipeline",
            "cable",
            "conveyor",
            "onsite_none"
          ],
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "route.frequency",
          "label_en": "Frequency",
          "type": "enum",
          "enum_values": [
            "continuous",
            "daily",
            "weekly",
            "monthly",
            "ad_hoc"
          ],
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "route.measured_volume_year",
          "label_en": "Measured volume (per year)",
          "type": "float",
          "required": false,
          "activation_predicate": "False",
          "description_en": "Retired: the quantity of the flow is the one written in the Flow Matrix. Stored values are kept and not exported."
        },
        {
          "id": "route.projected_volume_year",
          "label_en": "Projected volume per scenario (per year)",
          "type": "float_per_scenario",
          "required": false,
          "activation_predicate": "False",
          "description_en": "Retired: the quantity of the flow is the one written in the Flow Matrix. Stored values are kept and not exported."
        },
        {
          "id": "route.backhaul_strategy",
          "label_en": "Backhaul strategy",
          "type": "enum",
          "enum_values": [
            "none",
            "partial",
            "full"
          ],
          "required": false,
          "activation_predicate": "always"
        },
        {
          "id": "route.transport_lci_dataset",
          "label_en": "Transport LCI dataset reference",
          "type": "string_docref",
          "required": false,
          "activation_predicate": "q3.env",
          "filled_by": "analyst"
        },
        {
          "id": "route.transport_cost_per_unit",
          "label_en": "Transport cost (number)",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.eco",
          "description_en": "As billed: per unit of the flow, per trip or per year; write the unit in the next column. The analyst turns it into a cost per unit of the flow and per km for the break-even distance (D4.2 §4.3)."
        },
        {
          "id": "route.transport_cost_unit",
          "label_en": "Unit of the transport cost (e.g. EUR/t of the flow, EUR/trip, EUR/year)",
          "type": "string",
          "required": false,
          "activation_predicate": "q3.eco",
          "description_en": "In the currency of the Costs & Revenues sheet. If per trip, add the trips per year (e.g. \"EUR/trip, 250 trips/year\")."
        },
        {
          "id": "route.transport_sensitivity",
          "label_en": "What makes this flow sensitive to distance",
          "type": "enum",
          "enum_values": [
            "bulky_low_value",
            "high_moisture",
            "piped_heat_steam_water",
            "high_value_commodity",
            "other"
          ],
          "required": false,
          "activation_predicate": "always",
          "description_en": "The break-even distance depends on the flow type (D4.2 §4.2): bulky or low-value, wet, heat/steam/water in pipes, or a high-value commodity.",
          "source_ref": "lcc_hc_06"
        },
        {
          "id": "route.break_even_distance_km",
          "label_en": "Break-even distance (km)",
          "type": "float",
          "min": 0,
          "required": false,
          "activation_predicate": "always",
          "filled_by": "analyst",
          "description_en": "Distance beyond which the exchange stops paying off for this flow, from your own sensitivity run on primary logistics data (D4.1 §12.3.1). Not a fixed assumption: do not copy a literature value.",
          "source_ref": "lca_hc_21"
        },
        {
          "id": "route.break_even_basis",
          "label_en": "Break-even basis",
          "type": "enum",
          "enum_values": [
            "gwp_only",
            "multi_category",
            "economic",
            "env_and_eco"
          ],
          "required": false,
          "activation_predicate": "always",
          "filled_by": "analyst",
          "description_en": "What the break-even was computed on; a GWP-only break-even can mislead (D4.1 §12.2.1).",
          "source_ref": "lca_hc_21"
        }
      ]
    },
    {
      "id": "costs",
      "title_en": "Costs & Revenues",
      "description_en": "The economic terms of the exchange, one row per flow. Gated on the economic dimension: without q3.eco the engine configures no LCC and this section does not apply. `cost.current_disposal_cost` is the economic counterfactual — what the origin actor pays today for the flow the symbiosis diverts (D4.2 calls this reference the CNSRS, Current Non-Symbiotic Reference Scenario); without it there is no avoided cost to put against the investment.",
      "applies_when": "q3.eco",
      "row_collection": "auto_from_flow_matrix",
      "filled_by": "company",
      "fields": [
        {
          "id": "cost.flow_id",
          "label_en": "Flow (FK)",
          "type": "fk_flow",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "cost.current_disposal_cost",
          "label_en": "Current disposal / management cost (avoided)",
          "type": "float",
          "required": false,
          "activation_predicate": "always",
          "description_en": "What the origin actor pays today to get rid of this flow. The economic counterfactual (CNSRS): the symbiosis avoids it."
        },
        {
          "id": "cost.disposal_cost_unit",
          "label_en": "Unit of the avoided disposal cost (e.g. EUR/t of the flow, EUR/year)",
          "type": "string",
          "required": false,
          "activation_predicate": "always",
          "description_en": "Filled in by the origin actor. Per unit of the flow, in the unit of the Flow Matrix, or per year: say which."
        },
        {
          "id": "cost.avoided_procurement_cost",
          "label_en": "What the destination actor pays today for what this flow replaces (avoided purchase)",
          "type": "float",
          "required": false,
          "activation_predicate": "always",
          "description_en": "The recipient's avoided cost: what it would buy without the exchange (D4.2 §6.2 L00769)."
        },
        {
          "id": "cost.avoided_procurement_unit",
          "label_en": "Unit of the avoided purchase (e.g. EUR/t of what is replaced, EUR/year)",
          "type": "string",
          "required": false,
          "activation_predicate": "always",
          "description_en": "Filled in by the destination actor. If the figure is per unit of the product replaced, name that product and how much of it one unit of the flow replaces (the Flow classification names the replaced product); otherwise per unit of the flow or per year. The analyst brings the two avoided costs to one basis (D4.2 §5.3)."
        },
        {
          "id": "cost.exchange_price",
          "label_en": "Price the destination actor pays the origin actor (per unit)",
          "type": "float",
          "required": false,
          "activation_predicate": "always",
          "description_en": "Positive: the receiver pays. Zero: free. Negative: the origin actor pays the receiver a gate fee to take the flow (D4.2 §5.2)."
        },
        {
          "id": "cost.price_basis",
          "label_en": "Basis of that price",
          "type": "enum",
          "required": false,
          "activation_predicate": "always",
          "enum_values": [
            "gate_fee",
            "gate_fee_paid",
            "gate_fee_received",
            "market_price",
            "free",
            "negotiated"
          ]
        },
        {
          "id": "cost.opex_delta_year",
          "label_en": "Change in the origin actor's yearly operating cost, excluding transport (+ cost, − saving)",
          "type": "float",
          "required": false,
          "activation_predicate": "always",
          "description_en": "Operating cost the exchange adds or removes per year, excluding transport (that lives in Logistics)."
        },
        {
          "id": "cost.opex_delta_dest_year",
          "label_en": "Change in the destination actor's yearly operating cost, excluding transport (+ cost, − saving)",
          "type": "float",
          "required": false,
          "activation_predicate": "always",
          "description_en": "Each firm's actual cost structure (D4.2 §5.3 L00701): what the exchange adds or saves for the receiver."
        },
        {
          "id": "cost.currency_year",
          "label_en": "Currency and reference year",
          "type": "string",
          "required": true,
          "activation_predicate": "always",
          "description_en": "e.g. EUR2024. Required: without it the figures cannot be compared or deflated."
        },
        {
          "id": "cost.contract_horizon_y",
          "label_en": "Contract horizon (years)",
          "type": "int",
          "required": false,
          "activation_predicate": "q2 == \"B\" or has_scenarios",
          "description_en": "How long the arrangement is agreed for. Asked for prospective studies, where it bounds the payback."
        },
        {
          "id": "cost.price_volatility",
          "label_en": "Price volatility",
          "type": "enum",
          "required": false,
          "activation_predicate": "q2 == \"B\" or has_scenarios",
          "enum_values": [
            "low",
            "med",
            "high",
            "unknown"
          ]
        },
        {
          "id": "cost.externality_monetized",
          "label_en": "Externalities monetised for this flow",
          "type": "bool",
          "required": false,
          "activation_predicate": "lcc_type in [\"C+E\", \"C+E+S\"]",
          "filled_by": "analyst",
          "description_en": "Monetising environmental impacts belongs to E-LCC and S-LCC, not to a conventional LCC (D4.2 §2.2). Flag it so the same amount is not counted twice, once as a cash cost and once as an externality."
        }
      ]
    },
    {
      "id": "infrastructure",
      "title_en": "Infrastructure",
      "description_en": "The assets that exist because of the exchanges, one row per asset: storage, pre-treatment, pipelines, loading and metering, conversion units built or enlarged for them, and any production step changed for a partner. Not the main production line that would run the same without the exchange: it is the same in the symbiosis and in the reference and cancels out (D4.1 §6.3.3; D4.2 §4.2).",
      "applies_when": "always",
      "row_collection": "user_added",
      "filled_by": "company",
      "fields": [
        {
          "id": "infra.id",
          "label_en": "Infrastructure ID",
          "type": "string",
          "required": true,
          "activation_predicate": "always",
          "filled_by": "engine"
        },
        {
          "id": "infra.description",
          "label_en": "Asset (what it is)",
          "type": "string",
          "required": true,
          "activation_predicate": "always",
          "description_en": "Name and size in a few words, e.g. \"whey storage tank, 200 m³\" or \"steam pipeline, 1.2 km\"."
        },
        {
          "id": "infra.linked_actor_id",
          "label_en": "Linked actor (FK)",
          "type": "fk_actor",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "infra.flow_id",
          "label_en": "Flow served",
          "type": "fk_flow",
          "required": false,
          "activation_predicate": "always",
          "description_en": "The flow this asset exists for. Leave blank if it serves the whole network or several flows."
        },
        {
          "id": "infra.purpose",
          "label_en": "Purpose",
          "type": "enum",
          "enum_values": [
            "production",
            "treatment",
            "transport",
            "storage",
            "conversion",
            "supporting"
          ],
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "infra.status",
          "label_en": "Status",
          "type": "enum",
          "enum_values": [
            "existing",
            "new",
            "replaced",
            "upgraded",
            "decommissioned"
          ],
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "infra.capacity_value",
          "label_en": "Capacity (numeric)",
          "type": "float",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "infra.capacity_unit",
          "label_en": "Capacity unit",
          "type": "string",
          "required": true,
          "activation_predicate": "always"
        },
        {
          "id": "infra.year_built",
          "label_en": "Year built",
          "type": "int",
          "required": false,
          "activation_predicate": "always",
          "row_condition": "infra.status in [\"existing\", \"replaced\", \"upgraded\"]"
        },
        {
          "id": "infra.expected_lifetime_remaining_y",
          "label_en": "Expected remaining lifetime (years)",
          "type": "int",
          "required": false,
          "activation_predicate": "always",
          "row_condition": "infra.status in [\"existing\", \"replaced\", \"upgraded\"]"
        },
        {
          "id": "infra.capex_amount",
          "label_en": "CAPEX amount",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.eco and (q2 == \"B\" or has_scenarios or dedicated_shared_assets == True)",
          "row_condition": "infra.status == \"new\""
        },
        {
          "id": "infra.capex_currency_year",
          "label_en": "CAPEX currency + reference year (e.g. EUR2024)",
          "type": "string",
          "required": false,
          "activation_predicate": "q3.eco and (q2 == \"B\" or has_scenarios or dedicated_shared_assets == True)",
          "row_condition": "infra.status == \"new\""
        },
        {
          "id": "infra.amortization_period_y",
          "label_en": "Technical lifetime (years)",
          "type": "int",
          "description_en": "How many years the asset is expected to work: the period over which its cost is annualised in the LCC and its production and end of life are amortised in the LCA (D4.2 §4.2, §7.3; D4.1 §6.3.3). Not the tax depreciation period. Reference values, D4.2 Table 7.1: buildings and general infrastructure 20-30 years, processing equipment and machinery 5-8 years, boilers 6, specific biorefineries 15.",
          "required": false,
          "activation_predicate": "q2 == \"B\" or has_scenarios or dedicated_shared_assets == True",
          "row_condition": "infra.status == \"new\"",
          "source_ref": "lcc_hc_07"
        },
        {
          "id": "infra.discount_rate_pct",
          "label_en": "Discount rate (%)",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.eco and (q2 == \"B\" or has_scenarios or dedicated_shared_assets == True)",
          "filled_by": "analyst",
          "row_condition": "infra.status == \"new\""
        },
        {
          "id": "infra.salvage_value",
          "label_en": "Salvage value",
          "type": "float",
          "required": false,
          "activation_predicate": "q3.eco",
          "row_condition": "infra.status == \"replaced\""
        },
        {
          "id": "infra.avoided_lifetime_y",
          "label_en": "Avoided lifetime (years, for substitution accounting)",
          "type": "int",
          "required": false,
          "activation_predicate": "(q3.env or q3.eco) and ilcd_situation != \"ILCD Situation C2\"",
          "filled_by": "analyst",
          "row_condition": "infra.status == \"replaced\""
        },
        {
          "id": "infra.decommissioning_cost",
          "label_en": "Decommissioning cost",
          "type": "float",
          "required": false,
          "activation_predicate": "lcc_type in [\"C+E+S\", \"C+N+S\"]",
          "row_condition": "infra.status == \"decommissioned\" or lcc_type in [\"C+E+S\", \"C+N+S\"]"
        },
        {
          "id": "infra.ssp_rcp_scenario",
          "label_en": "SSP/RCP scenario (dynamic background)",
          "type": "enum",
          "enum_values": [
            "SSP1-26",
            "SSP2-45",
            "SSP3-70",
            "SSP4-60",
            "SSP5-85"
          ],
          "required": false,
          "activation_predicate": "future_background and (q3.env or q3.eco)",
          "filled_by": "analyst",
          "source_ref": "lcc_hc_23"
        },
        {
          "id": "infra.ownership",
          "label_en": "Ownership model",
          "type": "enum",
          "enum_values": [
            "single_actor",
            "joint_venture",
            "third_party",
            "public"
          ],
          "required": false,
          "activation_predicate": "q3.eco and dedicated_shared_assets != False"
        }
      ]
    },
    {
      "id": "methodological_choices",
      "title_en": "Methodological Choices to Document",
      "description_en": "The methodological practices this case has to document, grouped by category. The engine fills this sheet in from your answers: it is not something a data provider completes, it is the list the assessment team has to act on and record in the LCSA report.",
      "applies_when": "always",
      "row_collection": "auto_from_activated_nodes",
      "filled_by": "analyst",
      "auto_source": {
        "type": "procedural_mandates",
        "census_file": "backend/coordination/dcf_mandates_census.json",
        "categories": [
          "data_sources_quality",
          "allocation_substitution",
          "reference_scenario",
          "goal_scope_boundary",
          "stakeholder_materiality",
          "uncertainty_sensitivity",
          "reporting_disclosure",
          "lcc_method_specific",
          "lcsa_integration"
        ]
      },
      "fields_per_mandate": [
        {
          "id": "mandate.node_id",
          "label_en": "Mandate node ID",
          "type": "string",
          "required": true,
          "description_en": "Stable phase1 node id (e.g. slca_mc_11)."
        },
        {
          "id": "mandate.statement",
          "label_en": "Mandate statement",
          "type": "string",
          "required": true,
          "description_en": "Pulled from phase1_nodes.json default_value."
        },
        {
          "id": "mandate.category",
          "label_en": "Category",
          "type": "enum",
          "enum_ref": "auto_source.categories",
          "required": true
        },
        {
          "id": "mandate.deliverable",
          "label_en": "Deliverable target (report section / annex / external doc)",
          "type": "string",
          "required": false
        },
        {
          "id": "mandate.assignee",
          "label_en": "Assignee",
          "type": "string",
          "required": false
        },
        {
          "id": "mandate.status",
          "label_en": "Status",
          "type": "enum",
          "enum_values": [
            "pending",
            "in_progress",
            "done"
          ],
          "default": "pending",
          "required": true
        }
      ]
    },
    {
      "id": "network_diagram",
      "title_en": "Network Diagram",
      "description_en": "The links of the network, drawn from the Actors and Flow Matrix sheets. Edit it in the Network builder of the web app, where actors and flows are placed and connected; this sheet lists the links, the drawing stays in the app.",
      "applies_when": "always",
      "row_collection": "derived",
      "render_spec": {
        "nodes": {
          "source": "actors",
          "color_by": "actor.sector",
          "color_palette_ref": "Q6a",
          "shape_by": "actor.role",
          "shape_map": {
            "partner": "circle",
            "producer": "circle",
            "consumer": "square",
            "facilitator": "hexagon",
            "regulator": "diamond",
            "intermediary": "triangle"
          },
          "label": "actor.name"
        },
        "edges": {
          "source": "flow_matrix",
          "from": "flow.origin_actor_id",
          "to": "flow.dest_actor_id",
          "thickness_by": "flow.quantity_measured_or_projected_normalized",
          "color_by": "flow.type",
          "label": "flow.name"
        },
        "annotations": {
          "badges": [
            "ilcd_situation",
            "lcc_type"
          ],
          "icons_for_active_dims": [
            "q3.env",
            "q3.eco",
            "q3.soc"
          ]
        },
        "layout": {
          "default": "force_directed",
          "alternative": "hierarchical"
        },
        "export_targets": [
          "svg_inline",
          "png_for_docx_embed"
        ],
        "library_candidate": "reactflow",
        "library_license": "MIT"
      }
    }
  ]
}
